# Docker Compose backend settings. Copy this file to .env and replace values.
# Docker Desktop on Windows reaches a host MySQL instance at host.docker.internal.
DATABASE_URL="mysql://cloudcart_user:CHANGE_ME@host.docker.internal:3306/cloudcart"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=5000
CLIENT_URL="http://localhost"

# Public build-time value for the Vite image; it must not contain secrets.
VITE_API_URL=/api

# The server waits for MySQL before it begins accepting traffic.
DATABASE_CONNECT_RETRIES=30
DATABASE_CONNECT_RETRY_DELAY_MS=2000
